# Copy to .devcontainer/.env. Never put secrets in this file.
ROS_DOMAIN_ID=0
DEV_MEMORY_LIMIT=8g

# Docker Desktop host-networking trial: loopback on both sides.
# For Docker Engine in WSL2, use the reachable Windows IPv4 as the peer
# and the WSL IPv4 as the local address. See README.md before starting.
ROS_DDS_PEERS=127.0.0.1
ROS_DDS_ADDRESS=127.0.0.1

# Optional GPU configuration selects one GPU, not a reserved VRAM allocation.
NVIDIA_GPU_ID=0
